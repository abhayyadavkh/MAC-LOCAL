<widgets xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://www.hybris.com/schema/cockpitng/widgets.xsd">

	<widget-extension widgetId="backofficeMainSlot">
		<widget id="trainingcustombackofficesomething" widgetDefinitionId="com.hybris.cockpitng.borderlayout" slotId="perspectives" title="custombackofficemysearch" template="false">
			<widget id="mySearch" widgetDefinitionId="com.hybris.training.backoffice.widgets.mycustomsearch" slotId="leftSlot" />
		</widget>
	</widget-extension>


	<widget-extension widgetId="backofficeMainSlot">
		<widget id="myextension" widgetDefinitionId="com.hybris.cockpitng.borderlayout" slotId="perspectives"
				template="false" title="myextension">
			<widget id="myChatLeft" widgetDefinitionId="com.hybris.training.backoffice.widgets.mychat" slotId="leftSlot"/>
			<widget id="myChatRight" widgetDefinitionId="com.hybris.training.backoffice.widgets.mychat" slotId="rightSlot"/>
		</widget>
	</widget-extension>

	<widget-connection sourceWidgetId="myChatLeft" outputId="outgoingMsg" targetWidgetId="myChatRight" inputId="incomingMsg"/>
	<widget-connection sourceWidgetId="myChatRight" outputId="outgoingMsg" targetWidgetId="myChatLeft" inputId="incomingMsg"/>


</widgets>
