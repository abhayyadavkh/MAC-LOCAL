# ImpEx for Importing Store / Point of Service Media

# Macros / Replacement Parameter definitions
$productCatalog=__PRODUCT_CATALOG_NAME__
$storeName=__CONTENT_CATALOG_NAME__

$catalogVersion=catalogversion(catalog(id[default=$productCatalog]),version[default='Staged'])[unique=true,default=$productCatalog:Staged]
$media=@media[translator=de.hybris.platform.impex.jalo.media.MediaDataTranslator]
$medias=medias(code, $catalogVersion)
$siteResource=jar:com.hybris.training.initialdata.setup.InitialDataSystemSetup&/traininginitialdata/import/store/$storeName

# Create Media
INSERT_UPDATE Media;mediaFormat(qualifier);;code[unique=true];$media;mime[default='image/jpeg'];$catalogVersion;folder(qualifier)

# Create Media Containers
INSERT_UPDATE MediaContainer;qualifier[unique=true];$medias;$catalogVersion


INSERT_UPDATE HelloWorldCronJob;code[unique=true];job(code);sessionLanguage(isocode);
                               ;myHelloWorldServicelayerCronJob;myJobPerformable;en;

INSERT_UPDATE Trigger; cronjob(code)[unique=true]    ; cronExpression
                     ; outboundSyncSupervisorCronJob ; 30 2,12,22,32,42,52 * * * ?